PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reformstudio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reformstudio?schema=public"
JWT_SECRET="reform-studio-dev-secret-change-in-prod"
CORS_ORIGIN="http://localhost:5173"

# Belépőkód levél (TICKET-35, SendPulse SMTP REST API). Kulcs nélkül, nem production módban
# a kód a szerver naplójába kerül levél helyett; productionben a hiányzó kulcs indítási hiba.
SENDPULSE_API_KEY=""
MAIL_FROM_EMAIL="devtest@sendpulseemail.com"
MAIL_FROM_NAME="ReformStudio Sync"
# Kimenő levélsor (TICKET-55): óránként legfeljebb ennyi levél (SendPulse teszt csomag: 10).
MAIL_HOURLY_LIMIT=10
# A webapp nyilvános címe a leiratkozó linkhez (/leiratkozas/:token); alapból a CORS_ORIGIN első címe.
PUBLIC_WEB_URL="http://localhost:5173"
# Csak tesztekhez (E2E/CI), production módban nem engedélyezett: ezzel a kóddal lehet belépni, levél nélkül.
# AUTH_FIXED_LOGIN_CODE="123456"
