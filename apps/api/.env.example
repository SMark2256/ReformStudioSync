# Belépőkód levél (TICKET-35, SendPulse SMTP REST API). Kulcs nélkül, nem production módban
# a kód a szerver naplójába kerül levél helyett; productionben a hiányzó kulcs indítási hiba.
SENDPULSE_API_KEY=""
MAIL_FROM_EMAIL="devtest@sendpulseemail.com"
MAIL_FROM_NAME="ReformStudio Sync"
# Csak tesztekhez (E2E/CI), production módban nem engedélyezett: ezzel a kóddal lehet belépni, levél nélkül.
# AUTH_FIXED_LOGIN_CODE="123456"

# Online foglalás (TICKET-57). A levelek linkjeinek címe; üresen a CORS_ORIGIN első eleme.
PUBLIC_WEB_URL="http://localhost:5173"
