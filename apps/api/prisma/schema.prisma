datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  RECEPTIONIST
}

enum GuestStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

// TICKET-42: a csak nőknek szóló szolgáltatásokhoz (női köredzés).
enum Gender {
  FEMALE
  MALE
  UNSPECIFIED
}

enum ServiceCategory {
  CIRCUIT
  COSMETIC
  BODY_SHAPING
}

enum PassType {
  OCCASION_BASED
  TIME_BASED
  /// Napijegy (TICKET-7): egy alkalom, a vásárlás napján zárásig érvényes (`GuestPass.validUntil`).
  DAY_TICKET
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum MembershipDueStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
}

enum VisitType {
  CIRCUIT_TRAINING
  TREATMENT
}

enum PaymentMethod {
  CASH
  POS_CARD
  BANK_TRANSFER
}

enum CheckInStatus {
  SUCCESS
  DENIED
  DUPLICATE_SCAN
  CANCELLED
}

enum DocumentType {
  GDPR_CONSENT
  HEALTH_QUESTIONNAIRE
  HOUSE_RULES
  TREATMENT_CONSENT
}

enum DocumentStatus {
  PENDING_SIGNATURE
  SIGNED
}

// TICKET-56: a párosított eszköz szerepe.
enum DisplayDeviceKind {
  MONITOR
  TABLET
}

// TICKET-56: a vendégfelvétel állapotai (állapotgép: packages/shared/src/intake.ts).
enum IntakeStatus {
  PREPARED
  GUEST_FILLING
  AWAITING_REVIEW
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

// TICKET-56: a vendégfotó célja; a belső azonosító profilkép nem marketingcélú.
enum PhotoPurpose {
  PROGRESS
  PROFILE
}

// TICKET-55: a kimenő sor állapota (várakozik → elküldve / hibás).
enum MessageStatus {
  PENDING
  SENT
  FAILED
}

// TICKET-55: tranzakciós (üdvözlő, egyéni) vagy marketing (köszöntő, csoportos) levél.
enum EmailCategory {
  TRANSACTIONAL
  MARKETING
}

enum EmailAutomationKind {
  WELCOME
  BIRTHDAY
  NAME_DAY
}

model User {
  id           String   @id @default(uuid())
  studioId     String   @default("default-studio") @map("studio_id")
  email        String   @unique
  // TICKET-35 óta nincs jelszavas belépés; az oszlop csak a régi adatok miatt maradt.
  passwordHash String?  @map("password_hash")
  name         String
  role         Role     @default(RECEPTIONIST)
  isActive     Boolean  @default(true) @map("is_active")
  // TICKET-53: a látott oldalbemutatók (`{ seen: string[], closedAt: { [id]: lépés } }`, tours modul).
  tourState    Json     @default("{}") @map("tour_state")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  checkIns        LoggedCheckIn[]
  payments        Payment[]
  visits          Visit[]
  passUsages      PassUsageLog[]
  auditLogs       AuditLog[]
  notes           GuestNote[]
  measurements    Measurement[]
  createdIntakes  IntakeSession[] @relation("IntakeCreatedBy")
  approvedIntakes IntakeSession[] @relation("IntakeApprovedBy")
  emailTemplates EmailTemplate[]
  sentMessages   MessageLog[]
  bookings        Booking[]

  @@index([studioId])
  @@map("users")
}

model Guest {
  id          String      @id @default(uuid())
  studioId    String      @default("default-studio") @map("studio_id")
  barcode     String
  firstName   String      @map("first_name")
  lastName    String      @map("last_name")
  email       String?
  phone       String?
  birthDate   DateTime?   @map("birth_date")
  nameDay     String?     @map("name_day")
  gender      Gender      @default(UNSPECIFIED)
  status      GuestStatus @default(ACTIVE)
  notes       String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  // TICKET-55: marketing levelek hozzájárulása; az időpont az utolsó változásé (megadás / visszavonás).
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at")
  // Leiratkozó link vendégenként (`/leiratkozas/:token`); a leiratkozás a hozzájárulást is visszavonja.
  unsubscribeToken   String    @unique @default(uuid()) @map("unsubscribe_token")
  unsubscribedAt     DateTime? @map("unsubscribed_at")

  passes              GuestPass[]
  memberships         Membership[]
  checkIns            LoggedCheckIn[]
  visits              Visit[]
  passUsages          PassUsageLog[]
  payments            Payment[]
  measurements        Measurement[]
  photos              GuestPhoto[]
  documents           GuestDocument[]
  internalNotes       GuestNote[]
  messageLogs         MessageLog[]
  intakeSessions      IntakeSession[]
  intakeHealthRecords IntakeHealthRecord[]
  intakeSnapshots     IntakeDocumentSnapshot[]
  bookings      Booking[]
  waitlist      WaitlistEntry[]

  @@unique([studioId, barcode])
  @@index([studioId, lastName, firstName])
  @@map("guests")
}

model Service {
  id              String          @id @default(uuid())
  studioId        String          @default("default-studio") @map("studio_id")
  name            String
  category        ServiceCategory @default(BODY_SHAPING)
  durationMinutes Int             @default(30) @map("duration_minutes")
  priceHuf        Int             @default(0) @map("price_huf")
  /// Csak nőknek szól: férfi vendégnek nem adható el, vele nem léptethető be (TICKET-42).
  womenOnly       Boolean         @default(false) @map("women_only")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")

  passTemplates PassTemplate[]
  guestPasses   GuestPass[]
  passUsages    PassUsageLog[]
  photos        GuestPhoto[]
  memberships   Membership[]
  treatments    BookableTreatment[]

  @@index([studioId, isActive])
  @@map("services")
}

model Membership {
  id            String           @id @default(uuid())
  studioId      String           @default("default-studio") @map("studio_id")
  guestId       String           @map("guest_id")
  /// A tagság szolgáltatása (a stúdió köredzése); a csak nőknek szóló korlátozás innen jön.
  serviceId     String?          @map("service_id")
  monthlyFeeHuf Int              @map("monthly_fee_huf")
  startDate     DateTime         @map("start_date")
  dueDay        Int              @default(10) @map("due_day")
  status        MembershipStatus @default(ACTIVE)
  pausedAt      DateTime?        @map("paused_at")
  terminatedAt  DateTime?        @map("terminated_at")
  resumedAt     DateTime?        @map("resumed_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  guest   Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  service Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  dues    MembershipDue[]

  @@index([guestId, status])
  @@map("memberships")
}

model MembershipDue {
  id            String              @id @default(uuid())
  membershipId  String              @map("membership_id")
  period        String              // YYYY-MM
  dueDate       DateTime            @map("due_date")
  amountHuf     Int                 @map("amount_huf")
  paidAmountHuf Int                 @default(0) @map("paid_amount_huf")
  status        MembershipDueStatus @default(PENDING)
  createdAt     DateTime            @default(now()) @map("created_at")

  membership  Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([membershipId, period])
  @@index([dueDate, status])
  @@map("membership_dues")
}

model PassTemplate {
  id           String   @id @default(uuid())
  studioId     String   @default("default-studio") @map("studio_id")
  serviceId    String?  @map("service_id")
  name         String
  type         PassType
  totalPasses  Int?     @map("total_passes")
  durationDays Int      @map("duration_days")
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  service         Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  purchasedPasses GuestPass[]

  @@index([studioId, isActive])
  @@map("pass_templates")
}

model GuestPass {
  id              String    @id @default(uuid())
  studioId        String    @default("default-studio") @map("studio_id")
  guestId         String    @map("guest_id")
  passTemplateId  String    @map("pass_template_id")
  serviceId       String?   @map("service_id")
  type            PassType
  totalPasses     Int?      @map("total_passes")
  remainingPasses Int?      @map("remaining_passes")
  startDate       DateTime  @map("start_date")
  expirationDate  DateTime  @map("expiration_date")
  /// Percre pontos lejárat (napijegy: az eladás napjának zárása, eladáskor számolva, TICKET-7).
  /// `null`: csak a napra pontos `expirationDate` számít.
  validUntil      DateTime? @map("valid_until")
  isActive        Boolean   @default(true) @map("is_active")
  isFrozen        Boolean   @default(false) @map("is_frozen")
  frozenAt        DateTime? @map("frozen_at")
  /// A bérlet eladásának sztornója (az eladási befizetés sztornózásakor) — ettől kezdve nem használható.
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  guest        Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  passTemplate PassTemplate        @relation(fields: [passTemplateId], references: [id])
  service      Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  usageLogs    PassUsageLog[]
  payments     Payment[]
  allocations  PaymentAllocation[]
  checkIns     LoggedCheckIn[]

  @@index([guestId, isActive, expirationDate])
  @@map("guest_passes")
}

model Visit {
  id          String    @id @default(uuid())
  studioId    String    @default("default-studio") @map("studio_id")
  guestId     String    @map("guest_id")
  checkedInAt DateTime  @default(now()) @map("checked_in_at")
  visitType   VisitType @default(CIRCUIT_TRAINING) @map("visit_type")
  employeeId  String    @map("employee_id")

  guest    Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  employee User           @relation(fields: [employeeId], references: [id])
  checkIn  LoggedCheckIn?

  @@index([guestId, checkedInAt])
  @@index([studioId, checkedInAt])
  @@map("visits")
}

model LoggedCheckIn {
  id             String        @id @default(uuid())
  studioId       String        @default("default-studio") @map("studio_id")
  guestId        String        @map("guest_id")
  guestPassId    String?       @map("guest_pass_id")
  userId         String        @map("user_id")
  visitType      VisitType     @default(CIRCUIT_TRAINING) @map("visit_type")
  status         CheckInStatus @default(SUCCESS)
  reason         String?
  idempotencyKey String?       @unique @map("idempotency_key")
  /// A beléptetéshez tartozó látogatás; sztornókor a látogatás törlődik.
  visitId        String?       @unique @map("visit_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  guest     Guest         @relation(fields: [guestId], references: [id])
  guestPass GuestPass?    @relation(fields: [guestPassId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  visit     Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  passUsage PassUsageLog?

  @@index([guestId, createdAt])
  @@index([studioId, createdAt])
  @@map("logged_check_ins")
}

model PassUsageLog {
  id             String    @id @default(uuid())
  guestPassId    String    @map("guest_pass_id")
  guestId        String?   @map("guest_id")
  serviceId      String?   @map("service_id")
  employeeId     String?   @map("employee_id")
  delta          Int       @default(-1)
  usedAt         DateTime  @default(now()) @map("used_at")
  reversedAt     DateTime? @map("reversed_at")
  reversalReason String?   @map("reversal_reason")
  operationKey   String?   @unique @map("operation_key")
  /// A levonáshoz tartozó beléptetés: bármelyik oldal visszavonása a másikat is lezárja.
  checkInId      String?   @unique @map("check_in_id")
  note           String?

  guestPass GuestPass      @relation(fields: [guestPassId], references: [id], onDelete: Cascade)
  guest     Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  service   Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  employee  User?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  checkIn   LoggedCheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  booking   Booking?

  @@index([guestPassId, usedAt])
  @@map("pass_usage_logs")
}

model Payment {
  id               String        @id @default(uuid())
  studioId         String        @default("default-studio") @map("studio_id")
  guestId          String        @map("guest_id")
  guestPassId      String?       @map("guest_pass_id")
  recordedByUserId String        @map("recorded_by_user_id")
  amount           Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  isCancelled      Boolean       @default(false) @map("is_cancelled")
  note             String?
  createdAt        DateTime      @default(now()) @map("created_at")

  guest       Guest               @relation(fields: [guestId], references: [id])
  guestPass   GuestPass?          @relation(fields: [guestPassId], references: [id], onDelete: SetNull)
  recordedBy  User                @relation(fields: [recordedByUserId], references: [id])
  allocations PaymentAllocation[]

  @@index([studioId, createdAt, paymentMethod])
  @@index([guestPassId, createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  membershipDueId String?  @map("membership_due_id")
  passId          String?  @map("pass_id")
  amountHuf       Int      @map("amount_huf")
  createdAt       DateTime @default(now()) @map("created_at")

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  membershipDue MembershipDue? @relation(fields: [membershipDueId], references: [id], onDelete: SetNull)
  pass          GuestPass?     @relation(fields: [passId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("payment_allocations")
}

model AuditLog {
  id         String   @id @default(uuid())
  studioId   String   @default("default-studio") @map("studio_id")
  /// `null`: a vendég saját online művelete (TICKET-57), nem munkatárs.
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([studioId, createdAt])
  @@map("audit_logs")
}

model Measurement {
  id                    String   @id @default(uuid())
  guestId               String   @map("guest_id")
  recordedById          String?  @map("recorded_by_id")
  measuredAt            DateTime @default(now()) @map("measured_at")
  weightKg              Float?   @map("weight_kg")
  bodyFatPct            Float?   @map("body_fat_pct")
  muscleMassKg          Float?   @map("muscle_mass_kg")
  visceralFat           Float?   @map("visceral_fat")
  waistCm               Float?   @map("waist_cm")
  hipCm                 Float?   @map("hip_cm")
  thighCm               Float?   @map("thigh_cm")
  armCm                 Float?   @map("arm_cm")
  chestCm               Float?   @map("chest_cm")
  // TICKET-56: az Omron mérő értékei és a felvételi körfogatok.
  bmi                   Float?   @map("bmi")
  skeletalMusclePct     Float?   @map("skeletal_muscle_pct")
  restingMetabolismKcal Float?   @map("resting_metabolism_kcal")
  abdomenCm             Float?   @map("abdomen_cm")
  aboveKneeCm           Float?   @map("above_knee_cm")
  calfCm                Float?   @map("calf_cm")
  /// A mérés a vendégfelvétel jóváhagyásakor jött létre.
  intakeSessionId       String?  @map("intake_session_id")
  note                  String?

  guest         Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  recordedBy    User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  intakeSession IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: SetNull)

  @@index([guestId, measuredAt])
  @@map("measurements")
}

model GuestPhoto {
  id                  String       @id @default(uuid())
  guestId             String       @map("guest_id")
  serviceId           String?      @map("service_id")
  takenAt             DateTime     @default(now()) @map("taken_at")
  fileUrl             String       @map("file_url")
  mimeType            String       @default("image/webp") @map("mime_type")
  originalSizeBytes   Int          @default(0) @map("original_size_bytes")
  compressedSizeBytes Int          @default(0) @map("compressed_size_bytes")
  width               Int          @default(0)
  height              Int          @default(0)
  visibilityRole      Role         @default(RECEPTIONIST) @map("visibility_role")
  purpose             PhotoPurpose @default(PROGRESS)
  note                String?

  guest   Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([guestId, takenAt])
  @@map("photos")
}

model GuestDocument {
  id               String         @id @default(uuid())
  guestId          String         @map("guest_id")
  documentType     DocumentType   @default(GDPR_CONSENT) @map("document_type")
  title            String
  contentText      String         @map("content_text")
  fieldsJson       String?        @map("fields_json")
  signatureDataUrl String?        @map("signature_data_url")
  signedAt         DateTime?      @map("signed_at")
  status           DocumentStatus @default(PENDING_SIGNATURE)
  createdAt        DateTime       @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, status])
  @@map("documents")
}

model GuestNote {
  id        String   @id @default(uuid())
  guestId   String   @map("guest_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  guest  Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([guestId, createdAt])
  @@map("notes")
}

// Kimenő levelek sora és naplója (TICKET-55). Minden levél ide kerül (várakozik), és a
// `MailingScheduler` küldi ki az óránkénti korláttal, hibánál visszalépő újrapróbálással.
// A TICKET-55 előtti sorok is itt maradtak (`created_at` = a régi `sent_at`).
model MessageLog {
  id             String        @id @default(uuid())
  studioId       String        @default("default-studio") @map("studio_id")
  // Tesztlevélnél nincs vendég; a vendég törlése után a napló megmarad.
  guestId        String?       @map("guest_id")
  recipientEmail String        @map("recipient_email")
  recipientName  String?       @map("recipient_name")
  subject        String
  /// WELCOME, BIRTHDAY, NAME_DAY, MANUAL, BULK, TEST (a régi sorokban szabad szöveg).
  messageType    String        @map("message_type")
  category       EmailCategory @default(TRANSACTIONAL)
  status         MessageStatus @default(PENDING)
  html           String?
  text           String?
  templateId     String?       @map("template_id")
  /// A sablon neve a küldéskor (a sablon törlése vagy átnevezése után is olvasható).
  templateName   String?       @map("template_name")
  batchId        String?       @map("batch_id")
  /// Dupla küldés kizárása, pl. `BIRTHDAY:<vendég>:2026`: egy kulccsal csak egy sor lehet.
  dedupeKey      String?       @unique @map("dedupe_key")
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now()) @map("next_attempt_at")
  lastAttemptAt  DateTime?     @map("last_attempt_at")
  createdById    String?       @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  /// A tényleges kiküldés ideje; várakozó vagy hibás levélnél üres.
  sentAt         DateTime?     @map("sent_at")
  errorDetails   String?       @map("error_details")

  guest     Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  template  EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([guestId, createdAt])
  @@index([studioId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, sentAt])
  @@map("message_logs")
}

// E-mail-sablon (TICKET-55): tárgy és szanitizált HTML törzs `{{mezo}}` helyőrzőkkel.
model EmailTemplate {
  id          String   @id @default(uuid())
  studioId    String   @default("default-studio") @map("studio_id")
  name        String
  subject     String
  bodyHtml    String   @map("body_html")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy   User?             @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  automations EmailAutomation[]
  messages    MessageLog[]

  @@index([studioId, name])
  @@map("email_templates")
}

// Automatikus levél (TICKET-55): stúdiónként fajtánként egy sor, külön ki- és bekapcsolható.
model EmailAutomation {
  id         String              @id @default(uuid())
  studioId   String              @default("default-studio") @map("studio_id")
  kind       EmailAutomationKind
  enabled    Boolean             @default(false)
  templateId String?             @map("template_id")
  /// Az utolsó bekapcsolás: a pótlás ennél korábbi napra nem küld.
  enabledAt  DateTime?           @map("enabled_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([studioId, kind])
  @@map("email_automations")
}

model DisplayDevice {
  id               String            @id @default(uuid())
  studioId         String            @default("default-studio") @map("studio_id")
  name             String
  kind             DisplayDeviceKind @default(MONITOR)
  pairingCode      String?           @unique @map("pairing_code")
  pairingExpiresAt DateTime?         @map("pairing_expires_at")
  pairedAt         DateTime?         @map("paired_at")
  deviceToken      String            @unique @map("device_token")
  isActive         Boolean           @default(true) @map("is_active")
  lastSeenAt       DateTime?         @map("last_seen_at")
  lastActivityType String?           @map("last_activity_type")
  createdAt        DateTime          @default(now()) @map("created_at")

  intakeSessions IntakeSession[]

  @@unique([studioId, name])
  @@map("display_devices")
}

// E-mailben küldött belépőkód (TICKET-35). Címhez kötött, nem felhasználóhoz: ismeretlen
// címre is készül (felhasználhatatlan) sor, így a korlátozás sem árulja el, ki munkatárs.
model LoginCode {
  id         String    @id @default(uuid())
  email      String
  // HMAC-SHA256(JWT_SECRET, kód), hexában; maga a kód nincs tárolva.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([createdAt])
  @@map("login_codes")
}


// ---------------------------------------------------------------------------
// Online időpontfoglalás (TICKET-57)
// ---------------------------------------------------------------------------

enum BookingStatus {
  CONFIRMED
  LATE
  ARRIVED
  NO_SHOW
  CANCELLED
}

enum BookingSource {
  ONLINE
  RECEPTION
  WAITLIST
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CalendarSyncOperation {
  UPSERT
  DELETE
}

enum CalendarSyncStatus {
  PENDING
  DONE
  FAILED
}

/// Gép: az egyidejű kapacitás itt van. A HIEMT és az Intimpad közös, 1 fős gépet használ.
model BookingResource {
  id        String   @id @default(uuid())
  studioId  String   @default("default-studio") @map("studio_id")
  name      String
  capacity  Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  treatments BookableTreatment[]
  bookings   Booking[]
  closures   BookingClosure[]

  @@unique([studioId, name])
  @@map("booking_resources")
}

/// Foglalható kezelés: időtartam, a gép szünete (foglaltság) és a többkezeléses sorrend.
model BookableTreatment {
  id              String   @id @default(uuid())
  studioId        String   @default("default-studio") @map("studio_id")
  resourceId      String   @map("resource_id")
  /// A bérletillesztés szolgáltatása (`passCoversService`).
  serviceId       String?  @map("service_id")
  name            String
  durationMinutes Int      @map("duration_minutes")
  bufferMinutes   Int      @default(5) @map("buffer_minutes")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  isOnline        Boolean  @default(true) @map("is_online")
  createdAt       DateTime @default(now()) @map("created_at")

  resource BookingResource @relation(fields: [resourceId], references: [id])
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  bookings Booking[]
  waitlist WaitlistEntry[]

  @@unique([studioId, name])
  @@map("bookable_treatments")
}

/// Kezelésenként egy sor; a többkezeléses foglalás sorai közös `groupId`-t kapnak.
model Booking {
  id                 String        @id @default(uuid())
  studioId           String        @default("default-studio") @map("studio_id")
  groupId            String        @map("group_id")
  guestId            String        @map("guest_id")
  treatmentId        String        @map("treatment_id")
  resourceId         String        @map("resource_id")
  startsAt           DateTime      @map("starts_at")
  endsAt             DateTime      @map("ends_at")
  /// A kezelés vége + a gép szünete: eddig foglalt a gép.
  blockedUntil       DateTime      @map("blocked_until")
  status             BookingStatus @default(CONFIRMED)
  source             BookingSource @default(RECEPTION)
  note               String?
  /// Bérlet-figyelmeztetés a foglaláskor (`BookingPassWarning`), levonás és tartozás nélkül.
  passWarning        String?       @map("pass_warning")
  /// A kezelőlink tokenjének SHA-256 hash-e; maga a token nincs tárolva.
  manageTokenHash    String?       @unique @map("manage_token_hash")
  /// A foglaláshoz tartozó (pontosan egy) alkalomlevonás.
  passUsageId        String?       @unique @map("pass_usage_id")
  /// A levonás idempotenciakulcsának sorszáma: visszavonás után nő.
  deductionSeq       Int           @default(0) @map("deduction_seq")
  googleEventId      String?       @map("google_event_id")
  confirmationSentAt DateTime?     @map("confirmation_sent_at")
  reminderSentAt     DateTime?     @map("reminder_sent_at")
  reminderAttempts   Int           @default(0) @map("reminder_attempts")
  arrivedAt          DateTime?     @map("arrived_at")
  noShowAt           DateTime?     @map("no_show_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancelReason       String?       @map("cancel_reason")
  createdById        String?       @map("created_by_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  guest     Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  treatment BookableTreatment    @relation(fields: [treatmentId], references: [id])
  resource  BookingResource      @relation(fields: [resourceId], references: [id])
  passUsage PassUsageLog?        @relation(fields: [passUsageId], references: [id], onDelete: SetNull)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  syncItems CalendarSyncOutbox[]

  @@index([studioId, startsAt])
  @@index([resourceId, startsAt])
  @@index([guestId, startsAt])
  @@index([groupId])
  @@index([status, startsAt])
  @@map("bookings")
}

/// Stúdiószintű beállítások: heti nyitvatartás és a foglalási korlátok.
model BookingSettings {
  studioId          String   @id @default("default-studio") @map("studio_id")
  /// 7 elem (hétfő…vasárnap): `{ opensAt, closesAt, lastStartAt }` percben, vagy `null` (zárva).
  openingHours      Json     @map("opening_hours")
  maxAdvanceDays    Int      @default(30) @map("max_advance_days")
  minLeadMinutes    Int      @default(30) @map("min_lead_minutes")
  changeCutoffHours Int      @default(24) @map("change_cutoff_hours")
  holdMinutes       Int      @default(30) @map("hold_minutes")
  slotStepMinutes   Int      @default(15) @map("slot_step_minutes")
  locationText      String   @default("") @map("location_text")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("booking_settings")
}

/// Rendkívüli (teljes vagy részleges) zárvatartás, vagy `resourceId`-vel gépenkénti letiltás.
/// A meglévő foglalásokat nem módosítja, csak jelzi.
model BookingClosure {
  id          String   @id @default(uuid())
  studioId    String   @default("default-studio") @map("studio_id")
  resourceId  String?  @map("resource_id")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  reason      String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  resource BookingResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([studioId, startsAt])
  @@map("booking_closures")
}

/// Munkaszüneti nap felülírása (nyitva), vagy egy nap zárása.
model BookingHolidayOverride {
  id        String   @id @default(uuid())
  studioId  String   @default("default-studio") @map("studio_id")
  dayKey    String   @map("day_key")
  isOpen    Boolean  @map("is_open")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studioId, dayKey])
  @@map("booking_holiday_overrides")
}

/// Várólista: kezelésre és napra/idősávra. Felszabaduláskor a legrégebbi megfelelő jelentkező
/// kap ajánlatot és kizárólagos tartást (`OFFERED`, `offerExpiresAt`-ig a kapacitásba számít).
model WaitlistEntry {
  id             String         @id @default(uuid())
  studioId       String         @default("default-studio") @map("studio_id")
  guestId        String         @map("guest_id")
  treatmentId    String         @map("treatment_id")
  dayKey         String         @map("day_key")
  fromMinutes    Int            @map("from_minutes")
  toMinutes      Int            @map("to_minutes")
  status         WaitlistStatus @default(WAITING)
  offerStartsAt  DateTime?      @map("offer_starts_at")
  offerExpiresAt DateTime?      @map("offer_expires_at")
  offerTokenHash String?        @unique @map("offer_token_hash")
  offeredAt      DateTime?      @map("offered_at")
  bookingId      String?        @map("booking_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  guest     Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  treatment BookableTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@index([studioId, dayKey, status])
  @@index([status, offerExpiresAt])
  @@map("booking_waitlist")
}

/// Egyirányú Google Naptár szinkron sora. Foglalásonként legfeljebb egy függő tétel.
model CalendarSyncOutbox {
  id            String                @id @default(uuid())
  studioId      String                @default("default-studio") @map("studio_id")
  bookingId     String                @map("booking_id")
  operation     CalendarSyncOperation
  status        CalendarSyncStatus    @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at")
  lastError     String?               @map("last_error")
  processedAt   DateTime?             @map("processed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([bookingId, status])
  @@map("calendar_sync_outbox")
}

/// Vendég belépőkódja a nyilvános foglalóhoz (a `LoginCode` mintájára, külön táblában).
model GuestLoginCode {
  id         String    @id @default(uuid())
  email      String
  /// HMAC-SHA256 hexában; maga a kód nincs tárolva.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([createdAt])
  @@map("guest_login_codes")
}

// ---------------------------------------------------------------------------------------------
// Tabletes vendégfelvétel (TICKET-56)
// ---------------------------------------------------------------------------------------------

/// Felvételi csomag (Köredzés, Hypoxi, később továbbiak); a beépítetteket az API induláskor tölti fel.
model IntakePackage {
  id          String   @id @default(uuid())
  studioId    String   @default("default-studio") @map("studio_id")
  key         String
  label       String
  description String   @default("")
  /// A csomag szolgáltatásspecifikus űrlapjainak kulcsai (a közös űrlapok mindig hozzáadódnak).
  formKeys    String[] @map("form_keys")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([studioId, key])
  @@map("intake_packages")
}

/// Verziózott kérdőív / dokumentum definíció. Új szöveg új verzió; a régi nem módosul.
model IntakeFormDefinition {
  id                 String   @id @default(uuid())
  key                String
  version            Int
  title              String
  kind               String
  /// `COMMON` vagy a csomag kulcsa.
  scope              String
  sortOrder          Int      @map("sort_order")
  bodyText           String   @map("body_text")
  questions          Json
  requiresSignature  Boolean  @default(true) @map("requires_signature")
  legalReviewPending Boolean  @default(true) @map("legal_review_pending")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([key, version])
  @@map("intake_form_definitions")
}

model IntakeSession {
  id                  String       @id @default(uuid())
  studioId            String       @default("default-studio") @map("studio_id")
  /// Meglévő vendég, vagy jóváhagyás után az új vendég.
  guestId             String?      @map("guest_id")
  /// Duplikátumnál: jóváhagyáskor ehhez a meglévő vendéghez kerülnek az adatok.
  linkGuestId         String?      @map("link_guest_id")
  status              IntakeStatus @default(PREPARED)
  source              String       @default("PC")
  packageKeys         String[]     @map("package_keys")
  /// A kért űrlapok kulcsa és verziója (`[{ key, version }]`), az előkészítéskor rögzítve.
  formRefs            Json         @map("form_refs")
  profileDraft        Json         @default("{}") @map("profile_draft")
  /// A nem egészségügyi űrlapok válaszai; az egészségügyiek: intake_health_records.
  answers             Json         @default("{}")
  measurementDraft    Json         @default("{}") @map("measurement_draft")
  profilePhotoDataUrl String?      @map("profile_photo_data_url")
  signatureDataUrl    String?      @map("signature_data_url")
  signedAt            DateTime?    @map("signed_at")
  /// SHA-256(vendégtoken); maga a token nincs tárolva.
  guestTokenHash      String?      @unique @map("guest_token_hash")
  guestTokenExpiresAt DateTime?    @map("guest_token_expires_at")
  /// HMAC(kilépési kód); a vendégmódból csak ezzel (vagy a recepció PC-jéről) lehet kilépni.
  exitCodeHash        String?      @map("exit_code_hash")
  exitAttempts        Int          @default(0) @map("exit_attempts")
  /// A vendégmódot ezen az eszközön indító munkatárs: kilépéskor ő kap új munkamenetet.
  handoverUserId      String?      @map("handover_user_id")
  assignedDeviceId    String?      @map("assigned_device_id")
  createdById         String       @map("created_by_id")
  approvedById        String?      @map("approved_by_id")
  approvedAt          DateTime?    @map("approved_at")
  completedAt         DateTime?    @map("completed_at")
  failureReason       String?      @map("failure_reason")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  guest          Guest?                   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  assignedDevice DisplayDevice?           @relation(fields: [assignedDeviceId], references: [id], onDelete: SetNull)
  createdBy      User                     @relation("IntakeCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?                    @relation("IntakeApprovedBy", fields: [approvedById], references: [id])
  healthRecord   IntakeHealthRecord?
  snapshots      IntakeDocumentSnapshot[]
  measurements   Measurement[]

  @@index([studioId, status, updatedAt])
  @@index([guestId])
  @@index([assignedDeviceId, status])
  @@map("intake_sessions")
}

/// Egészségügyi válaszok, a vendég általános adataitól elkülönítve. Minden olvasás auditnaplóba kerül.
model IntakeHealthRecord {
  id             String    @id @default(uuid())
  sessionId      String    @unique @map("session_id")
  guestId        String?   @map("guest_id")
  /// Űrlapkulcs → válaszok (egészségügyi kérdőív és ellenjavallatok).
  answers        Json      @default("{}")
  consentGivenAt DateTime? @map("consent_given_at")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest   Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([guestId])
  @@map("intake_health_records")
}

/// Az aláírt dokumentum változatlan pillanatképe (szöveg, verzió, válaszok, aláírás, időbélyeg).
/// A tartalmi oszlopok módosítását adatbázis-trigger tiltja; csak a PDF adatai tölthetők ki utólag.
model IntakeDocumentSnapshot {
  id                 String    @id @default(uuid())
  sessionId          String    @map("session_id")
  guestId            String    @map("guest_id")
  formKey            String    @map("form_key")
  formVersion        Int       @map("form_version")
  title              String
  bodyText           String    @map("body_text")
  answers            Json
  signatureDataUrl   String    @map("signature_data_url")
  signedAt           DateTime  @map("signed_at")
  legalReviewPending Boolean   @map("legal_review_pending")
  /// SHA-256 a tartalmi mezőkből: a változatlanság ellenőrizhető.
  contentHash        String    @map("content_hash")
  pdfStorageKey      String?   @map("pdf_storage_key")
  pdfSizeBytes       Int?      @map("pdf_size_bytes")
  pdfCreatedAt       DateTime? @map("pdf_created_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest   Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([sessionId, formKey])
  @@index([guestId, signedAt])
  @@map("intake_document_snapshots")
}
