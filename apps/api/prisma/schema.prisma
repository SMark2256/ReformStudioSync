datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  RECEPTIONIST
}

enum PassType {
  OCCASION_BASED
  TIME_BASED
}

enum PaymentMethod {
  CASH
  POS_CARD
  BANK_TRANSFER
}

enum CheckInStatus {
  SUCCESS
  DENIED
  DUPLICATE_SCAN
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  studioId     String   @default("default-studio") @map("studio_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(RECEPTIONIST)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  checkIns LoggedCheckIn[]
  payments Payment[]

  @@index([studioId])
  @@map("users")
}

model Guest {
  id          String   @id @default(uuid())
  studioId    String   @default("default-studio") @map("studio_id")
  barcode     String
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  phone       String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  passes   GuestPass[]
  checkIns LoggedCheckIn[]
  payments Payment[]

  @@unique([studioId, barcode])
  @@index([studioId, lastName, firstName])
  @@map("guests")
}

model PassTemplate {
  id           String   @id @default(uuid())
  studioId     String   @default("default-studio") @map("studio_id")
  name         String
  type         PassType
  totalPasses  Int?     @map("total_passes")
  durationDays Int      @map("duration_days")
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  purchasedPasses GuestPass[]

  @@index([studioId, isActive])
  @@map("pass_templates")
}

model GuestPass {
  id              String    @id @default(uuid())
  studioId        String    @default("default-studio") @map("studio_id")
  guestId         String    @map("guest_id")
  passTemplateId  String    @map("pass_template_id")
  type            PassType
  totalPasses     Int?      @map("total_passes")
  remainingPasses Int?      @map("remaining_passes")
  startDate       DateTime  @map("start_date")
  expirationDate  DateTime  @map("expiration_date")
  isActive        Boolean   @default(true) @map("is_active")
  isFrozen        Boolean   @default(false) @map("is_frozen")
  frozenAt        DateTime? @map("frozen_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  guest        Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  passTemplate PassTemplate    @relation(fields: [passTemplateId], references: [id])
  usageLogs    PassUsageLog[]
  payments     Payment[]
  checkIns     LoggedCheckIn[]

  @@index([guestId, isActive, expirationDate])
  @@map("guest_passes")
}

model LoggedCheckIn {
  id             String        @id @default(uuid())
  studioId       String        @default("default-studio") @map("studio_id")
  guestId        String        @map("guest_id")
  guestPassId    String?       @map("guest_pass_id")
  userId         String        @map("user_id")
  status         CheckInStatus @default(SUCCESS)
  reason         String?
  idempotencyKey String?       @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")

  guest     Guest      @relation(fields: [guestId], references: [id])
  guestPass GuestPass? @relation(fields: [guestPassId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@index([guestId, createdAt])
  @@index([studioId, createdAt])
  @@map("logged_check_ins")
}

model PassUsageLog {
  id          String   @id @default(uuid())
  guestPassId String   @map("guest_pass_id")
  delta       Int      @default(-1)
  usedAt      DateTime @default(now()) @map("used_at")
  note        String?

  guestPass GuestPass @relation(fields: [guestPassId], references: [id], onDelete: Cascade)

  @@index([guestPassId, usedAt])
  @@map("pass_usage_logs")
}

model Payment {
  id               String        @id @default(uuid())
  studioId         String        @default("default-studio") @map("studio_id")
  guestId          String        @map("guest_id")
  guestPassId      String?       @map("guest_pass_id")
  recordedByUserId String        @map("recorded_by_user_id")
  amount           Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  isCancelled      Boolean       @default(false) @map("is_cancelled")
  note             String?
  createdAt        DateTime      @default(now()) @map("created_at")

  guest      Guest      @relation(fields: [guestId], references: [id])
  guestPass  GuestPass? @relation(fields: [guestPassId], references: [id], onDelete: SetNull)
  recordedBy User       @relation(fields: [recordedByUserId], references: [id])

  @@index([studioId, createdAt, paymentMethod])
  @@map("payments")
}

model DisplayDevice {
  id          String   @id @default(uuid())
  studioId    String   @default("default-studio") @map("studio_id")
  name        String
  pairingCode String?  @unique @map("pairing_code")
  deviceToken String   @unique @map("device_token")
  isActive    Boolean  @default(true) @map("is_active")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("display_devices")
}
