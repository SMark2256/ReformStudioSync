{
  // Cloudflare Workers (Static Assets) — React + Vite SPA kiszolgálás.
  // Build: `npm run build:web` (a gyökérből) → apps/web/dist
  // Deploy: `npm run deploy:web` (a gyökérből)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // A Cloudflare dashboardon létrehozott Worker nevével egyeznie kell (Workers Builds).
  "name": "reformstudiosync",
  "compatibility_date": "2026-11-01",
  // Csak a preview-n fut le: ott a not_found_handling nem érvényesül (worker/index.ts).
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // react-router: minden ismeretlen útvonal az index.html-re esik vissza.
    "not_found_handling": "single-page-application"
  },
  // Workers Builds Previews: a nem éles ágak (pl. `demo`) `wrangler preview`-val
  // saját preview URL-t kapnak. A blokk lehet üres, de lennie kell.
  "previews": {}
}
