# --- BACKEND (apps/api) ---
PORT=3001
# Supabase Transaction Pooler (Port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Session / Direct Connection migrációkhoz (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="csereld-le-egy-eros-min-32-karakteres-titkos-kulcsra"
CORS_ORIGIN="http://localhost:5173"

# --- FRONTEND (apps/web) ---
VITE_API_URL="http://localhost:3001/api"
VITE_WS_URL="http://localhost:3001"
# Demó mód (mock fallback hálózati hibánál). Élesben "false"; a /demo oldal mindig demó.
VITE_DEMO_MODE="false"
